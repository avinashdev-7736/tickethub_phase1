# Copy to .env and change for anything beyond local development. Never commit .env.
MYSQL_ROOT_PASSWORD=root
INTERNAL_API_KEY=change-me-internal-key
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Services run with Spring profile 'docker'; add ,elk to ship logs to Logstash (also start: docker compose --profile elk up)
APP_PROFILES=docker
# Payment provider: simulated (default) or razorpay (TEST keys only)
PAYMENT_PROVIDER=simulated
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
# Poster storage (private S3 bucket). Leave empty to disable poster upload.
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
