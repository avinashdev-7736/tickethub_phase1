{
  "uid": "tickethub-overview",
  "title": "TicketHub Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / sec by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average latency (s) by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_sum[1m])) / sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx responses / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bookings: created / confirmed / expired / payment failed (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tickethub_booking_created_total[1m]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(increase(tickethub_booking_confirmed_total[1m]))",
          "legendFormat": "confirmed"
        },
        {
          "refId": "C",
          "expr": "sum(increase(tickethub_booking_expired_total[1m]))",
          "legendFormat": "expired"
        },
        {
          "refId": "D",
          "expr": "sum(increase(tickethub_booking_payment_failed_total[1m]))",
          "legendFormat": "payment failed"
        },
        {
          "refId": "E",
          "expr": "sum(increase(tickethub_booking_seat_conflict_total[1m]))",
          "legendFormat": "seat conflicts"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payments and notifications (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tickethub_payment_success_total[1m]))",
          "legendFormat": "payment success"
        },
        {
          "refId": "B",
          "expr": "sum(increase(tickethub_payment_failed_total[1m]))",
          "legendFormat": "payment failed"
        },
        {
          "refId": "C",
          "expr": "sum(increase(tickethub_payment_booking_sync_failed_total[1m]))",
          "legendFormat": "booking sync failed"
        },
        {
          "refId": "D",
          "expr": "sum(increase(tickethub_notification_sent_total[1m]))",
          "legendFormat": "email sent"
        },
        {
          "refId": "E",
          "expr": "sum(increase(tickethub_notification_failed_total[1m]))",
          "legendFormat": "email failed"
        },
        {
          "refId": "F",
          "expr": "sum(increase(tickethub_booking_event_publish_failed_total[1m]))",
          "legendFormat": "event publish failed"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Circuit breaker state (1 = active)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state == 1",
          "legendFormat": "{{application}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Kafka consumer lag (max, per service)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application) (kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Outbox: events waiting to reach Kafka",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tickethub_outbox_pending",
          "legendFormat": "{{application}}"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (increase(tickethub_outbox_publish_failed_total[1m]))",
          "legendFormat": "publish failures/min {{application}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Dead letters and email retries (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tickethub_notification_deadlettered_total[1m]))",
          "legendFormat": "dead-lettered"
        },
        {
          "refId": "B",
          "expr": "sum(increase(tickethub_notification_retrying_total[1m]))",
          "legendFormat": "email retrying"
        },
        {
          "refId": "C",
          "expr": "sum(increase(tickethub_notification_duplicate_total[1m]))",
          "legendFormat": "duplicates ignored"
        },
        {
          "refId": "D",
          "expr": "sum(increase(tickethub_notification_stale_total[1m]))",
          "legendFormat": "stale ignored"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Saga: rejections, refunds, stale/duplicate events (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tickethub_booking_rejected_total[1m]))",
          "legendFormat": "bookings rejected"
        },
        {
          "refId": "B",
          "expr": "sum(increase(tickethub_refund_completed_total[1m]))",
          "legendFormat": "refunds completed"
        },
        {
          "refId": "C",
          "expr": "sum(increase(tickethub_refund_failed_total[1m]))",
          "legendFormat": "refunds failed"
        },
        {
          "refId": "D",
          "expr": "sum(increase(tickethub_saga_stale_total[1m]))",
          "legendFormat": "stale ignored"
        },
        {
          "refId": "E",
          "expr": "sum(increase(tickethub_saga_duplicate_total[1m]))",
          "legendFormat": "duplicates ignored"
        },
        {
          "refId": "F",
          "expr": "sum(increase(tickethub_payment_unknown_total[1m]))",
          "legendFormat": "payments UNKNOWN"
        }
      ]
    }
  ],
  "tags": [
    "tickethub"
  ]
}