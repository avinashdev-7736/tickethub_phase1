{
  "realm": "tickethub",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Browses events, books seats and pays"
      },
      {
        "name": "ADMIN",
        "description": "Manages the catalogue"
      }
    ]
  },
  "clients": [
    {
      "clientId": "tickethub-web",
